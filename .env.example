# Local PostgreSQL service used by docker-compose.yml
POSTGRES_DB=gamelens
POSTGRES_USER=gamelens
POSTGRES_PASSWORD=gamelens_dev_only
POSTGRES_PORT=5432

# Stage 4 FastAPI application. Compose publishes it only on 127.0.0.1.
APP_NAME=GameLens AI API
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://gamelens:gamelens_dev_only@localhost:5432/gamelens
# Keep this origin's port aligned with WEB_PORT below.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MODEL_ARTIFACT_PATH=/artifacts/content-v1
# Optional immutable Stage 5 bundle selected once when the API starts. Leave
# blank for content-only serving; builders and operators use explicit paths.
COLLABORATIVE_ARTIFACT_PATH=
# Project-authored synthetic input used only by guarded fixture commands.
COLLABORATIVE_FIXTURE_PATH=/workspace/data/fixtures/interactions/collaborative-interactions.json
# Development-only credential protection. Replace this with at least 32 random
# bytes outside local development; never put an anonymous browser token here.
ANONYMOUS_SESSION_SECRET=development-only-stage-4-session-secret-change-me
ANONYMOUS_SESSION_COOKIE_NAME=gamelens_session
ANONYMOUS_SESSION_COOKIE_PATH=/api/v1
ANONYMOUS_SESSION_COOKIE_SECURE=false
ANONYMOUS_SESSION_COOKIE_SAMESITE=lax
ANONYMOUS_SESSION_TTL_SECONDS=15552000
# Live extraction and promotion are separate, default-off operator gates. Live
# mode also requires a separately approved contribution-consent version.
COLLABORATIVE_LIVE_DATA_ENABLED=false
COLLABORATIVE_CONTRIBUTION_CONSENT_VERSION=
COLLABORATIVE_LIVE_PROMOTION_ENABLED=false
# Fixture mode is mutually exclusive with every live-data authority setting and
# additionally requires ENVIRONMENT=test. Normal API/model services force it off.
COLLABORATIVE_ALLOW_TEST_FIXTURE=false
# These are frozen code contracts, not environment knobs: label policy
# gamelens-collaborative-labels/1.0.0; model
# gamelens-item-item-cosine/1.0.0; feedback policy
# gamelens-feedback-adjustment/1.0.0; scoring policy
# gamelens-collaborative-scoring/1.0.0; and hybrid policy
# gamelens-hybrid-ranking/1.0.0. Functional minima are 2 profile items,
# 2 item support, 2 pair support, 10 users, 20 positive edges, and 5 items.

CONSENT_VERSION=stage-4-v1
CSRF_HEADER_NAME=X-CSRF-Token
RECOMMENDATION_EVENT_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=500
# Linux bind mounts default to UID/GID 1000. Set these to `id -u` and `id -g`
# before building when the checkout is owned by different numeric IDs.
APP_UID=1000
APP_GID=1000

# Stage 4 Next.js application. These values are browser-visible.
# Keep this URL's port aligned with API_PORT above.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONSENT_VERSION=stage-4-v1
WEB_PORT=3000
