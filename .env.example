# Local PostgreSQL service used by docker-compose.yml
POSTGRES_DB=gamelens
POSTGRES_USER=gamelens
POSTGRES_PASSWORD=gamelens_dev_only
POSTGRES_PORT=5432

# Reserved for the Stage 1 FastAPI application
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://gamelens:gamelens_dev_only@localhost:5432/gamelens
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Reserved for the Stage 2 Next.js application
NEXT_PUBLIC_API_URL=http://localhost:8000
