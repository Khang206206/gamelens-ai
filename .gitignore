# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
htmlcov/
venv/

# Node.js and Next.js
.next/
.npm/
.pnpm-store/
coverage/
node_modules/
out/
playwright-report/
test-results/
blob-report/
*.tsbuildinfo

# Machine-learning outputs and local datasets
# External payloads are local verification inputs only. Keep source metadata,
# aggregate audits, and project-authored fixtures reviewable in Git.
data/external/*/payload/
data/private/
data/generated/
data/raw/
data/processed/
ml/artifacts/*
!ml/artifacts/.gitkeep
ml/reports/generated/*

# Local databases, logs, and runtime state
*.db
*.sqlite
*.sqlite3
*.log
logs/
tmp/

# IDE and operating-system files
.DS_Store
.idea/
.vscode/
Thumbs.db
